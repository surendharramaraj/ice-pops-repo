# Settings for the Icepops service. On the server this file is
# /etc/icepops/icepops.env (readable only by root and the icepops user).
# After changing it: sudo systemctl restart icepops

NODE_ENV=production

# The app listens only on this machine; nginx forwards visitors to it.
# If another program already uses this port, each deploy picks a free one
# (8040 to 8099) and updates this file and nginx.
HOST=127.0.0.1
PORT=8040
TRUST_PROXY=1

# PostgreSQL. setup-server.sh fills this in with a generated password.
# Postgres on another machine: use its address, and add PGSSL=off if it has no SSL.
DATABASE_URL=postgres://icepops:CHANGE_ME@127.0.0.1:5432/icepops

# Billing.
#   test      choosing a plan switches it on for a month WITHOUT payment.
#             Anyone who signs up can do this, so use it only until Razorpay is ready.
#   razorpay  real payments; fill in the three keys below.
BILLING_MODE=test
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
